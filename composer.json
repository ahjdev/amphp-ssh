{
    "name"       : "amphp/ssh",
    "homepage"   : "https://github.com/amphp/ssh",
    "description": "Async SSH client for PHP based on Amp.",
    "keywords"   : [
        "ssh",
        "ssh2",
        "sftp",
        "scp",
        "client",
        "async",
        "amp",
        "amphp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Joel Wurtz",
            "email": "jwurtz@jolicode.com"
        },
        {
            "name": "AmirHossein Jafari",
            "email": "amirhosseinjafari8228@gmail.com"
        }
    ],
    "require": {
        "ext-sodium"   : "*",
        "amphp/file"   : "^3",
        "amphp/socket" : "^2.3",
        "amphp/process": "^2.0",
        "amphp/websocket-client" : "*",
        "psr/log"      : "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit"          : "^9",
        "amphp/phpunit-util"       : "^3",
        "amphp/php-cs-fixer-config": "^2"
    },
    "autoload": {
        "psr-4": {
            "Amp\\Ssh\\": "src"
        },
        "files": [
            "src/functions.php",
            "src/Transport/functions.php",
            "src/KeyExchange/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Amp\\Ssh\\Test\\": "tests"
        }
    },
    "scripts": {
        "check": [
            "@code-style"
        ],
        "code-style": "php-cs-fixer fix -v --diff",
        "test": "@php -dzend.assertions=1 -dassert.exception=1 ./vendor/bin/phpunit --coverage-text"
    }
}
